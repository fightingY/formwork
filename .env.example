# miniCC 环境变量（密钥只放这里或系统环境，绝不写进 minicc.yaml）。
# 覆盖优先级：系统 env > 本文件 > minicc.yaml（已存在的变量不会被重复注入覆盖）。

# —— 上游密钥：minicc.yaml 里每条 route 的 api_key_env 指向这里的变量名 ——
SILICONFLOW_API_KEY=your_api_key_here
# BAILIAN_API_KEY=your_api_key_here
# RELAY_PRIVATE_API_KEY=your_api_key_here

# —— 兜底密钥：route 未声明 api_key_env 时回退到这一条 ——
# MINICC_API_KEY=your_api_key_here

# —— 可选覆盖 ——
# MINICC_PROVIDER=bailian                        # 覆盖 default_provider，换 upstream = 改一行
# MINICC_CHILD_PROVIDER=siliconflow              # 覆盖 child.provider（V4 子模型走哪条 route）
# MINICC_MODEL=deepseek-ai/DeepSeek-V4-Pro       # 覆盖默认 route 的 model
# MINICC_CHILD_MODEL=deepseek-ai/DeepSeek-V4-Flash  # 覆盖 child 的 model
# MINICC_PROVIDER_TIMEOUT_SEC=120                # 覆盖默认 route 的 timeout（秒）